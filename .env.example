# Synthetic demonstration database only. Neon Free is the initial public-demo target.
DATABASE_URL=postgresql://demo_owner:replace-me@replace-me.neon.tech/demo?sslmode=require

# Generate a random value of at least 32 characters. Never commit the real value.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Canonical origin. On Vercel, use the production URL shown for the project.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated exact origins. Keep localhost for local development and add only the deployed origin.
AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Public deployment origin used for absolute social metadata. No trailing slash.
# Vercel system URLs are used automatically when this value is omitted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
